#!/bin/bash
# SlackBuild modeled on nater1983/hostnamed main.
cd "$(dirname "$0")"; CWD=$(pwd)
PRGNAM=homed
VERSION=${VERSION:-0.1.0}
BUILD=${BUILD:-1}
TAG=${TAG:-_rdlnx}
PKGTYPE=${PKGTYPE:-txz}
if [ -z "${ARCH:-}" ]; then
  case "$(uname -m)" in i?86) ARCH=i586 ;; arm*) ARCH=arm ;; *) ARCH=$(uname -m) ;; esac
fi
if [ -n "${PRINT_PACKAGE_NAME:-}" ]; then echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"; exit 0; fi
TMP=${TMP:-/tmp}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}
case "$ARCH" in
  i586) SLKCFLAGS='-O2 -march=i586 -mtune=i686'; LIBDIRSUFFIX='' ;;
  i686) SLKCFLAGS='-O2 -march=i686 -mtune=i686'; LIBDIRSUFFIX='' ;;
  x86_64) SLKCFLAGS='-O2 -fPIC'; LIBDIRSUFFIX=64 ;;
  *) SLKCFLAGS='-O2'; LIBDIRSUFFIX='' ;;
esac
set -e
rm -rf "$PKG"
mkdir -p "$PKG" "$OUTPUT"
export CFLAGS="$SLKCFLAGS"
meson setup build --prefix=/usr --libdir="lib${LIBDIRSUFFIX}" --libexecdir=/usr/libexec --bindir=/usr/bin --sbindir=/usr/sbin --datadir=/usr/share --sysconfdir=/etc --localstatedir=/var --mandir=/usr/man --buildtype=release -Dtests=true -Dprivileged-group=wheel
ninja -C build
meson test -C build --print-errorlogs
DESTDIR="$PKG" ninja -C build install

# Compress and link manpages, if any:
if [ -d $PKG/usr/man ]; then
  ( cd $PKG/usr/man
    for manpagedir in $(find . -type d -name "man*") ; do
      ( cd $manpagedir
        for eachpage in $( find . -type l -maxdepth 1) ; do
          ln -s $( readlink $eachpage ).gz $eachpage.gz
          rm $eachpage
        done
        gzip -9 *.*
      )
    done
  )
fi
mkdir -p "$PKG/usr/doc/$PRGNAM-$VERSION" "$PKG/install"
cp README.md AUTHORS LICENSE ChangeLog.md "$PKG/usr/doc/$PRGNAM-$VERSION/"
cp slack/slack-desc "$PKG/install/slack-desc"
cd "$PKG"
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
